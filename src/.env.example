# .env.example — Modelo de configurações para Atividade 4.1 (GCP)
# Copie este arquivo para .env e preencha com seus dados reais.

# === Configuração do Banco de Dados MySQL ===
# Se estiver usando Docker local, use os valores abaixo:
DB_HOST=db
DB_PORT=3306
DB_NAME=app_projeto
DB_USER=root
DB_PASSWORD=root_password

# Se for usar Cloud SQL (GCP), preencha com o IP da instância:
# DB_HOST=35.x.x.x

# === Configuração do Google Cloud Storage ===
GCP_BUCKET_NAME=nome-do-seu-bucket
# Caminho para o arquivo JSON dentro do container
GOOGLE_APPLICATION_CREDENTIALS=/var/www/html/keys/service-account.json
