# .env.example — Configurações para Atividade 4.1 de Computação em Nuvem II
# Copie este arquivo para .env e preencha com seus dados reais.
# NUNCA publique o arquivo .env no GitHub!

# === Configurações de Banco de Dados (Cloud SQL) ===
# Se estiver testando localmente com Docker, use DB_HOST=db
# Para o Cloud SQL, use o IP público da instância.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=app_projeto
DB_USER=root
DB_PASSWORD=root_password

# === Configurações de Google Cloud Storage ===
# Nome exato do bucket criado no Google Cloud Console
GCP_BUCKET_NAME=seu-bucket-aqui

# Caminho relativo à pasta 'src/' para o arquivo JSON da Service Account
# Exemplo: keys/chave-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=keys/gcp-credentials.json
